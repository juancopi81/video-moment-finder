# Qdrant Cloud GitHub Login
QDRANT_URL=https://xxx-xxx.gcp.cloud.qdrant.io
QDRANT_API_KEY=api-key

# Cloudflare R2 GitHub Login
R2_ENDPOINT_URL=https://xxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=video-storage
R2_PUBLIC_URL=https://your-cdn.example.com  # optional, for public thumbnail URL
R2_UPLOAD_WORKERS=16  # parallel thumbnail uploads

# Supabase (PostgreSQL database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key  # server-only; never expose in browser
SUPABASE_DB_URL=postgresql://postgres:your-url-encoded-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
VIDEO_JOB_MAX_ATTEMPTS=3  # max processing attempts before terminal failure
VIDEO_JOB_STALE_LOCK_TIMEOUT_S=600  # recover processing jobs locked longer than this
VIDEO_JOB_IDLE_BACKOFF_MAX_S=15  # cap for empty-queue exponential polling backoff
VIDEO_JOB_DB_RETRY_BASE_DELAY_S=1  # initial delay after transient DB transport errors
VIDEO_JOB_DB_RETRY_MAX_DELAY_S=30  # cap for transient DB transport retry backoff
VIDEO_MAX_DURATION_S=1800  # reject videos longer than this many seconds
VIDEO_MAX_FREE_VIDEOS=1  # max free videos per user before payments are wired
VIDEO_SOURCE_URL_TTL_S=3600  # signed playback URL lifetime for uploaded videos
VIDEO_UPLOAD_URL_TTL_S=900  # signed upload URL lifetime for direct-to-R2 uploads
VIDEO_LOCAL_VIDEO_DIR=  # optional: local cache of pre-downloaded videos (<youtube_id>.<ext>)
CORS_ALLOWED_ORIGINS=http://localhost:3000  # comma-separated list; supports wildcard entries like https://video-moment-finder-*.vercel.app
CORS_ALLOWED_ORIGIN_REGEX=  # optional regex for dynamic origins (example: ^https://video-moment-finder-.*\\.vercel\\.app$)
LEMON_SQUEEZY_API_KEY=  # required to create /billing/checkout sessions
LEMON_SQUEEZY_STORE_ID=  # required to create /billing/checkout sessions
LEMON_SQUEEZY_VARIANT_ID_STARTER=  # paid Starter pack variant ID (5 credits)
LEMON_SQUEEZY_VARIANT_ID_PRO=  # paid Pro pack variant ID (20 credits)
LEMON_SQUEEZY_CHECKOUT_REDIRECT_URL=https://videomomentfinder.com/dashboard?checkout=success
LEMON_SQUEEZY_CHECKOUT_TEST_MODE=false  # true/false for checkout session mode (use true while validating without real cards)
LEMON_SQUEEZY_WEBHOOK_SECRET=  # required to verify /webhooks/lemonsqueezy signatures
BILLING_GRANT_EVENT_NAMES=order_created,subscription_payment_success  # comma-separated

# Clerk auth (backend token verification)
CLERK_ISSUER=https://your-clerk-issuer
CLERK_AUDIENCE=
CLERK_JWKS_URL=

# Frontend (copy these into frontend/.env.local; template: frontend/.env.example)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Modal auth (required in API + worker service environments)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional search latency experiment (default: unset keeps cost unchanged)
# Set to 1 only when benchmarking warm-container impact for text queries.
MODAL_TEXT_EMBED_MIN_CONTAINERS=
# Optional upper bound for text-embed containers (default: 1 for cache reuse)
MODAL_TEXT_EMBED_MAX_CONTAINERS=1
# Legacy alias still supported:
# MODAL_TEXT_EMBED_KEEP_WARM=
