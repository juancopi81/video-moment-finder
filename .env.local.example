# Local development overrides (copy to .env.local)
#
# This file is loaded BEFORE .env and overrides matching variables.
# Variables not set here fall through to .env defaults.
#
# Usage:
#   cp .env.local.example .env.local
#   just dev-services       # start local Supabase + Qdrant
#   just api                # API uses local Supabase + local Qdrant
#   just worker             # worker polls local DB (no Railway competition)

# --- Supabase: local instance via `supabase start` ---
# These are the well-known default keys from the local Supabase dev stack.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Qdrant: local Docker instance started by `just dev-services` ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Sentry: disabled locally ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# --- Modal: inherited from .env (shared GPU functions) ---
# MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are NOT overridden here,
# so they fall through to your .env production tokens.

# --- Auth: inherited from .env ---
# Clerk tokens fall through to .env. If you need a separate Clerk dev
# instance, override CLERK_ISSUER here.
